# Copiar a .env y completar. Nunca subir .env al repositorio.

# ---- PostgreSQL ----
DB_NAME=aegisops
DB_USER=aegisops
DB_PASSWORD=cambiar_esta_clave
# Puerto en el host (5433 para no chocar con un PostgreSQL local)
DB_HOST_PORT=5433
# Solo si el backend se ejecuta fuera de Docker (mvnw spring-boot:run)
DB_URL=jdbc:postgresql://localhost:5433/aegisops

# ---- Backend ----
BACKEND_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5500,http://127.0.0.1:5500
# Token compartido con n8n para /api/internal/** (cabecera X-Internal-Token).
# Vacío = sin protección (solo desarrollo).
INTERNAL_API_TOKEN=

# ---- n8n (lo llama SOLO el backend) ----
# Backend fuera de Docker:
N8N_BASE_URL=http://localhost:5678
# Backend dentro de Docker:
N8N_BASE_URL_DOCKER=http://host.docker.internal:5678
N8N_RAG_WEBHOOK=/webhook/aegisops-rag
N8N_INDEX_WEBHOOK=/webhook/aegisops-indexar
N8N_TIMEOUT=60s

# ---- RAG ----
# Similitud coseno mínima para aceptar una fuente (ver docs/informe-analisis-datos.md)
RAG_SIMILARITY_THRESHOLD=0.50
# Número de fuentes a recuperar (entre 3 y 5)
RAG_TOP_K=5

# ---- OpenRouter ----
# La clave NO la usa el backend: se registra en n8n como credencial
# "Header Auth" (Authorization: Bearer <clave>). Se deja aquí como referencia.
OPENROUTER_API_KEY=

# ---- Qdrant ----
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# ---- Frontend ----
FRONTEND_PORT=8081

TZ=America/Bogota
