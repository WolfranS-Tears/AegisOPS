      "id": "b2e8ed31-08b6-4eec-bce2-9c099c953d19",
      "name": "Validar fuentes (backend)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1360,
        -240
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Solo artículos que existen en la base relacional y están activos/verificados\nconst candidatas = $('Candidatas').first().json.candidatas;\nconst validos = Array.isArray($json.body) ? $json.body : [];\nconst porId = Object.fromEntries(validos.map(a => [a.id, a]));\nconst fuentes = candidatas\n  .filter(c => porId[c.articuloId])\n  .map(c => ({ articuloId: c.articuloId, titulo: porId[c.articuloId].titulo, similitud: c.similitud }));\n\nconst contexto = fuentes.map(f => {\n  const a = porId[f.articuloId];\n  return `[Artículo ${a.id}] ${a.titulo} (similitud ${f.similitud})\\n` +\n         `Categoría: ${a.categoria}\\nProblema: ${a.problema}\\nSíntomas: ${a.sintomas}\\n` +\n         `Causa: ${a.causa}\\nSolución: ${a.solucion}`;\n}).join('\\n\\n---\\n\\n');\n\nconst sistema = [\n  'Eres el asistente de soporte técnico de AegisOPS.',\n  'Responde ÚNICAMENTE con la información de los artículos del CONTEXTO.',\n  'No inventes pasos, comandos, causas ni datos que no aparezcan en el contexto.',\n  'Si los artículos no resuelven el problema descrito, responde con \"suficiente\": false.',\n  'Responde en español y SOLO con un objeto JSON con esta forma:',\n  '{\"suficiente\": boolean, \"solucion\": \"resumen de la solución sugerida\", ' +\n  '\"pasos\": [\"paso 1\", \"paso 2\"], \"fuentesUsadas\": [ids numéricos de los artículos usados]}',\n].join(' ');\n\nconst pregunta = $('Validar entrada').first().json.pregunta;\nreturn [{ json: {\n  fuentes,\n  hay: fuentes.length > 0,\n  messages: [\n    { role: 'system', content: sistema },\n    { role: 'user', content: `CONTEXTO:\\n${contexto}\\n\\nPROBLEMA DEL USUARIO:\\n${pregunta}` },\n  ],\n} }];"
      },
