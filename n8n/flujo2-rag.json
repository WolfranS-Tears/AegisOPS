    {
      "parameters": {
        "jsCode": "// Regla: una pregunta vacía nunca ejecuta el flujo inteligente\nconst c = $json;\nconst pregunta = String(c.pregunta || '').trim();\nlet umbral = Number(c.umbral);\nif (!Number.isFinite(umbral) || umbral < 0 || umbral > 1) umbral = 0.5;\nlet topK = parseInt(c.topK, 10);\nif (!Number.isFinite(topK)) topK = 5;\ntopK = Math.min(5, Math.max(3, topK));\nreturn [{ json: { ...c, pregunta, umbral, topK, valida: pregunta.length > 0 } }];"
      },
