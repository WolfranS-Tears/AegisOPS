        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $('Validar entrada').item.json.modeloChat, temperature: 0.1, response_format: { type: 'json_object' }, messages: $json.messages }) }}"
      },
      "id": "2107d683-ea2f-4649-a11c-abff678e6779",
      "name": "Generar respuesta (LLM)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2020,
        -360
      ],
      "onError": "continueErrorOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR_CREDENCIAL",
          "name": "OpenRouter API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Convierte la salida del LLM al contrato que espera Spring Boot\nconst ctx = $('Construir contexto').first().json;\nconst modelo = $json.model || $('Validar entrada').first().json.modeloChat;\nlet salida;\ntry {\n  let texto = $json.choices[0].message.content.trim();\n  texto = texto.replace(/^```(json)?/i, '').replace(/```$/, '').trim();\n  salida = JSON.parse(texto);\n} catch (e) {\n  return [{ json: { estado: 'ERROR', error: 'El modelo devolvió un formato no válido: ' + e.message } }];\n}\nconst solucion = String(salida.solucion || '').trim();\nif (salida.suficiente === false || !solucion) {\n  return [{ json: { estado: 'SIN_RESULTADOS', solucion: null, pasos: [], fuentes: [], modelo } }];\n}\nconst usadas = Array.isArray(salida.fuentesUsadas) ? salida.fuentesUsadas.map(Number) : [];\nlet fuentes = ctx.fuentes.filter(f => usadas.includes(f.articuloId));\nif (fuentes.length === 0) fuentes = ctx.fuentes;   // el modelo no citó: se reportan todas las recuperadas\nconst pasos = Array.isArray(salida.pasos) ? salida.pasos.map(p => String(p).trim()).filter(Boolean) : [];\nreturn [{ json: { estado: 'RESPONDIDA', solucion, pasos, fuentes, modelo } }];"
      },
