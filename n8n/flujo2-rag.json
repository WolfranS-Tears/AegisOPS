            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "b28cf166-b33a-45f1-b2f4-b91057a0902c",
              "leftValue": "={{ $json.hay }}",
              "rightValue": "",
