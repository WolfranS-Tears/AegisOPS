    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Validar entrada').item.json.qdrantUrl }}/collections/{{ $('Validar entrada').item.json.coleccion }}/points/search",
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ vector: $json.data[0].embedding, limit: $('Validar entrada').item.json.topK, score_threshold: $('Validar entrada').item.json.umbral, with_payload: true, filter: { must: [ { key: 'indexable', match: { value: true } } ] } }) }}"
      },
      "id": "8bfa9b25-8c81-4079-9796-e9680af7e99c",
      "name": "Buscar en Qdrant",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        -120
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Resultados semánticos sobre el umbral, con su similitud coseno\nconst cfg = $('Validar entrada').first().json;\nconst resultados = $json.result || [];\nconst candidatas = resultados\n  .map(r => ({\n    articuloId: Number((r.payload && r.payload.articulo_id) ?? r.id),\n    titulo: r.payload ? r.payload.titulo : null,\n    similitud: Math.round(r.score * 10000) / 10000,\n  }))\n  .filter(c => c.similitud >= cfg.umbral);\nreturn [{ json: { candidatas, ids: candidatas.map(c => c.articuloId).join(','), hay: candidatas.length > 0 } }];"
      },
      "id": "95c2b044-8916-47e8-946c-2dc753fb2770",
      "name": "Candidatas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        920,
        -120
      ]
    },
