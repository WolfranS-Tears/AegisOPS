          },
          "conditions": [
            {
              "id": "ac48ae92-ba68-49ed-855e-221008d15232",
              "leftValue": "={{ $('Preparar').first().json.hayRetirar }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
