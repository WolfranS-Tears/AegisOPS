        "url": "={{ $('Config').item.json.qdrantUrl }}/collections/{{ $('Config').item.json.coleccion }}/points/delete?wait=true",
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ points: $('Preparar').first().json.retirar }) }}"
      },
      "id": "3422e41d-478b-4755-a8b9-d8c396ba3d9b",
      "name": "Retirar de Qdrant",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1800,
        -120
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, coleccion: $('Config').first().json.coleccion, total: $('Preparar').first().json.total, indexados: $('Preparar').first().json.activos.length, retirados: $('Preparar').first().json.retirar.length }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "bd2c0d29-c5c1-4b3f-9441-b22e5c6f5dcb",
